# Deployment configuration for shared-list PWA
# Copy this file to .env and fill in the values

# SSH host for deployment server
# DEPLOY_HOST=your-server.example.com

# Directory on the server where the project is cloned
# DEPLOY_DIR=/path/to/your/project

# Path to uv binary on the server
# DEPLOY_UV=/path/to/uv

# Sanity limits suitable for shopping list, feel free to increase these
# Maximum string length of each item and shopping list name
MAX_ITEM_NAME_LENGTH=100
# Maximum number of items you can add in one list
MAX_ITEMS_PER_LIST=200
# Limits .dB to 4096*100=409.6kB
MAX_DB_PAGES=100
